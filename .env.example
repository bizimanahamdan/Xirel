# Copy this file to .env and adjust as needed. Every value below is optional
# for local use — the app runs fully offline with a local SQLite file if you
# skip this file entirely.

# Secret used to sign login session cookies. Set this to a long random string
# for anything beyond local testing.
JWT_SECRET=change-me-to-a-long-random-string

# If set, only this exact email can ever become admin (recommended for any
# public/deployed instance, so a stranger can't register first and grab the
# admin account). Leave unset for local use, where the first registered
# account becomes admin automatically.
# ADMIN_EMAIL=you@example.com

# Port the server listens on (default 3000; auto-picks the next free port if busy).
PORT=3000

# --- Local-only database (used automatically if the two Turso vars below are unset) ---
# DATABASE_FILE=./data/store.db

# --- Hosted database (required on any host whose local disk doesn't persist, e.g. free-tier PaaS) ---
# Get these from https://turso.tech (free, no credit card): create a database,
# then copy its URL and generate a token — both from Turso's web dashboard.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# --- Image hosting (recommended for any real deployment) ---
# Get these from your Cloudinary dashboard (cloudinary.com — free tier available).
# If unset, product images are instead stored as inline base64 data directly
# in the database, which works with zero setup but bloats page size.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# --- Support chat (optional) ---
# Get a free key (no credit card) at console.groq.com.
# GROQ_API_KEY=your-groq-api-key

# --- Printify (optional) ---
# Personal Access Token from Printify account settings. Once set, check the
# admin Products page — it'll show your shop IDs so you can set the second one.
# PRINTIFY_API_TOKEN=your-printify-token
# PRINTIFY_SHOP_ID=your-shop-id

# --- MTN MoMo Collections (optional) — real-time checkout payment ---
# Get these from momodeveloper.mtn.co.rw (Rwanda) once your Collections
# product is approved. Without these, checkout falls back to creating a
# pending order that you confirm manually (e.g. via WhatsApp).
# MOMO_API_USER=your-api-user
# MOMO_API_KEY=your-api-key
# MOMO_SUBSCRIPTION_KEY=your-subscription-key
# MOMO_TARGET_ENVIRONMENT=mtnrwanda
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Only needed if you want to override the default "RWF" in production —
# sandbox always uses EUR automatically regardless of this setting.
# MOMO_CURRENCY=RWF
