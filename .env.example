# Copy this file to .env and adjust as needed. Every value below is optional
# for local use — the app runs fully offline with a local SQLite file if you
# skip this file entirely.

# Secret used to sign login session cookies. Set this to a long random string
# for anything beyond local testing.
JWT_SECRET=change-me-to-a-long-random-string

# If set, only this exact email can ever become admin (recommended for any
# public/deployed instance, so a stranger can't register first and grab the
# admin account). Leave unset for local use, where the first registered
# account becomes admin automatically.
# ADMIN_EMAIL=you@example.com

# Port the server listens on (default 3000; auto-picks the next free port if busy).
PORT=3000

# --- Local-only database (used automatically if the two Turso vars below are unset) ---
# DATABASE_FILE=./data/store.db

# --- Hosted database (required on any host whose local disk doesn't persist, e.g. free-tier PaaS) ---
# Get these from https://turso.tech (free, no credit card): create a database,
# then copy its URL and generate a token — both from Turso's web dashboard.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here
