# Local development works without this value and emits a development-only warning.
# Production requires a unique random JWT_SECRET (at least 32 bytes, not a placeholder).
# Generate one with: openssl rand -base64 48
# JWT_SECRET=

# Explicit one-time bootstrap identity. When configured, this address is promoted
# only if no administrator already exists. There is no first-public-user promotion.
# ADMIN_EMAIL=you@example.com

# Session cookie lifetime (whole days, 1-30; default 7).
# SESSION_TTL_DAYS=7
# Optional domain for a shared parent-domain cookie. Leave unset for a safer host-only cookie.
# SESSION_COOKIE_DOMAIN=.example.com

# Number of trusted reverse-proxy hops. Render defaults to one in production;
# set 0 for a direct deployment or the exact hop count for another proxy chain.
# TRUST_PROXY_HOPS=1

# Port the server listens on (default 3000; auto-picks the next free port if busy).
PORT=3000

# --- Local-only database (used automatically if TURSO_DATABASE_URL is unset) ---
# DATABASE_FILE=./data/store.db

# --- Hosted database (use the same Turso DB for every app instance) ---
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# --- Image hosting (recommended for any real deployment) ---
# If unset, product images are stored as inline base64 data in the database.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# --- Support chat (optional) ---
# GROQ_API_KEY=your-groq-api-key

# --- Printify (optional) ---
# PRINTIFY_API_TOKEN=your-printify-token
# PRINTIFY_SHOP_ID=your-shop-id

# --- MTN MoMo Collections (optional) ---
# MOMO_API_USER=your-api-user
# MOMO_API_KEY=your-api-key
# MOMO_SUBSCRIPTION_KEY=your-subscription-key
# MOMO_TARGET_ENVIRONMENT=mtnrwanda
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MOMO_CURRENCY=RWF

# --- CJ Dropshipping (optional) ---
# CJ_API_KEY=your-cj-api-key

# --- Higgsfield product video generation (optional) ---
# HIGGSFIELD_API_KEY=your-higgsfield-api-key
# HIGGSFIELD_API_SECRET=your-higgsfield-api-secret
